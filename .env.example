# Google Gemini (Nano Banana 2 = Gemini 3 Pro Image)
GOOGLE_AI_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Discord invite that we redirect users to after registration
NEXT_PUBLIC_DISCORD_INVITE=https://discord.gg/your-invite-code

# Telegram invite (preferred over Discord for TBA hero CTA when set)
NEXT_PUBLIC_TELEGRAM_INVITE=

# Tournament — ISO con timezone. Si está vacía o en el pasado, la home renderiza
# el variant "Próximo torneo · TBA" con CTA a Telegram (o Discord como fallback).
NEXT_PUBLIC_TOURNAMENT_DATE=

# === Payments — Lemon Squeezy (merchant-of-record, no requiere LLC US) ===
# Dejar vacías mientras tournaments.entry_fee_usd = 0 (torneos free).
# Cuando un torneo tenga entry_fee_usd > 0, estas son obligatorias.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_ID_TOURNAMENT_ENTRY=

# === Email — Resend (confirmación post-pago) ===
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@papaque.online

# Public site URL (para construir return_url del checkout)
NEXT_PUBLIC_SITE_URL=https://papaque.online
